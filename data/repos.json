        },
        {
          "name": "FE-Xico UpdateR",
          "repo": "RoYoshi/FE-Xico-UpdateR",
          "private": true,
          "icon": "assets/icons/fe-xico-updater.png",
          "role": "child",
          "summary": [
            "The update app of FE-XicoOS, being written from scratch in C++ and Qt Quick. It checks for, downloads and rolls back FE-XicoOS updates, and shows the release notes, the update history and the technical details.",
            "It replaces the earlier updater based on Bazzite Updater by Robert French and contributors, which is kept as FE-Xico-UpdateR-olddy."
          ],
